# Скопируй этот файл в .env и впиши свои бесплатные ключи.
# Достаточно хотя бы одного провайдера, но для устойчивости лучше все три.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Необязательно: переопределить модели по умолчанию для каждого уровня.
# Справа указаны значения по умолчанию из кода (agent/llm.py). Значения в строках — примеры и могут отличаться.
# Провайдеры периодически снимают модели с поддержки, проверяй актуальные названия на сайте провайдера.
# GROQ_MODEL_FAST=openai/gpt-oss-20b                  # code default: openai/gpt-oss-20b
# GROQ_MODEL_STRONG=openai/gpt-oss-120b               # code default: openai/gpt-oss-120b
# OPENROUTER_MODEL_FAST=openrouter/free               # code default: meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_MODEL_STRONG=openrouter/free             # code default: meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite             # code default: gemini-2.5-flash
# GEMINI_MODEL_STRONG=gemini-3.6-flash                # code default: gemini-2.5-pro