# Скопируй этот файл в .env и впиши свои бесплатные ключи.
# Достаточно хотя бы одного провайдера, но для устойчивости лучше все три.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Необязательно: переопределить модели по умолчанию для каждого уровня.
# Значения ниже актуальны на момент публикации — провайдеры периодически
# снимают старые модели с поддержки, см. README (раздел про устаревание моделей).
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_STRONG=openai/gpt-oss-120b
# OPENROUTER_MODEL_FAST=openrouter/free
# OPENROUTER_MODEL_STRONG=openrouter/free
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_STRONG=gemini-3.6-flash