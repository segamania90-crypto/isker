# Скопируй этот файл в .env и впиши свои бесплатные ключи.
# Достаточно хотя бы одного провайдера, но для устойчивости лучше все три.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Необязательно: переопределить модели по умолчанию для каждого уровня.
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_STRONG=llama-3.3-70b-versatile
# OPENROUTER_MODEL_FAST=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_MODEL_STRONG=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL_FAST=gemini-1.5-flash
# GEMINI_MODEL_STRONG=gemini-1.5-pro
